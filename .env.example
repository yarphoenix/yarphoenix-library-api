# Скопируйте в .env (в .gitignore) и заполните реальными значениями.
# Ни одно значение отсюда не должно попадать в git или в образ.

ASPNETCORE_ENVIRONMENT=Production

POSTGRES_DB=yarphoenix
POSTGRES_USER=yarphoenix
POSTGRES_PASSWORD=change-me

MINIO_ROOT_USER=yarphoenix
MINIO_ROOT_PASSWORD=change-me

# Origin фронтенда для CORS (§11.4), например https://username.github.io
FRONTEND_ORIGIN=http://localhost:3000

# Секрет подписи JWT: минимум 32 символа, сгенерируйте случайный
# (например: openssl rand -hex 48).
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-chars

# --- Прод-деплой (docker compose --profile prod) ---

# Образ бэкенда из GHCR (его публикует CI). Пусто → образ собирается локально из исходников.
# Пример: ghcr.io/<owner>/yarphoenix-library-api:latest
BACKEND_IMAGE=

# Домен API, указывающий на VPS (A-запись) или форма sslip.io (1-2-3-4.sslip.io).
# Caddy получит по нему TLS-сертификат автоматически (§11.4).
API_DOMAIN=api.example.com

# Публичный базовый URL для ссылок на аватары — обычно тот же домен за Caddy.
MINIO_PUBLIC_URL=https://api.example.com

# Egress-прокси для исходящих запросов: archive.org и api.anthropic.com блокируются
# с RU-IP (§5.1.2, §8). Формат http://user:pass@host:port. Пусто → без прокси.
EGRESS_PROXY=

# Claude API (AI-ассистент). Пусто → ассистент мягко деградирует (§8.3).
ANTHROPIC_API_KEY=

# Resend (подтверждение почты, сброс пароля). Пусто → ссылки пишутся в лог (§5.2).
RESEND_API_KEY=
EMAIL_FROM=YarPhoenix Library <onboarding@resend.dev>
